{
  "name": "mdeditdiff",
  "version": "0.1.0",
  "description": "Free, open-source tool: an editor for people, a diff for agents. See what changed in a Markdown file since you last looked, and who changed it. CLI and MCP server for AI agents, plus a native macOS app, sharing one local change history.",
  "main": "dist/src/api.js",
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepare": "npm run build",
    "walkthrough": "npm run build && ./examples/walkthrough.sh"
  },
  "keywords": [
    "mcp",
    "markdown",
    "diff",
    "agents",
    "ai-agents",
    "claude-code",
    "change-tracking"
  ],
  "author": "Vinay Roy",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "markdown-it": "^14.3.3",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "mdeditdiff": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/roy-vinay/applied-ai-agents.git",
    "directory": "tools/mdeditdiff"
  }
}
